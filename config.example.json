{
  "roots": [
    "~/code"
  ],
  "port": 4477,
  "ci": {
    "holdPatterns": [
      "_hold$",
      "^Approve "
    ],
    "stripPrefixes": [
      "ci/circleci: "
    ]
  },
  "git": {
    "longLivedBranches": [
      "main",
      "develop",
      "release/*"
    ]
  },
  "github": {
    "copilotReviewer": "copilot-pull-request-reviewer[bot]",
    "issueRepos": []
  },
  "terminal": {
    "app": "auto"
  },
  "editor": {
    "urlScheme": "vscode"
  },
  "appearance": {
    "theme": "classic",
    "mode": "system"
  },
  "agents": {
    "parkedAfterHours": 24,
    "endedHistoryDays": 7,
    "interruptedAttentionDays": 3
  }
}
